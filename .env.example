# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./data/allegro_hunter.db
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Allegro OAuth. Never commit real values.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:8000/api/allegro/oauth/callback
ALLEGRO_ENVIRONMENT=production
ALLEGRO_USER_AGENT=AllegroProductHunter/0.1 (local application; contact: your-email@example.com)

# Optional cross-platform encryption fallback. Windows uses DPAPI automatically.
APP_ENCRYPTION_KEY=
